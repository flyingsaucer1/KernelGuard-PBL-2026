[Unit]
Description=KernelGuard local administrator dashboard
After=network.target

[Service]
Type=simple
User=kernelguard
Group=kernelguard
WorkingDirectory=/opt/kernelguard
EnvironmentFile=/etc/kernelguard/web.env
ExecStart=/opt/kernelguard/.venv/bin/python -m kernelguard --config /opt/kernelguard/config.example.json serve
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kernelguard/data
UMask=0077

[Install]
WantedBy=multi-user.target
