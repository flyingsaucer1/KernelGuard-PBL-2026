[Unit]
Description=KernelGuard Linux inventory collector
After=network.target systemd-udevd.service

[Service]
Type=simple
WorkingDirectory=/opt/kernelguard
EnvironmentFile=/etc/kernelguard/collector.env
ExecStart=/opt/kernelguard/.venv/bin/python -m kernelguard inventory
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/kernelguard/data
UMask=0077

[Install]
WantedBy=multi-user.target
